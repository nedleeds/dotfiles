custom-shader = shaders/thor.glsl
# custom-shader = shaders/thor_purple.glsl
# custom-shader = shaders/flash.glsl
# custom-shader = shaders/flame.glsl
theme = light:GitHub Light High Contrast,dark:GitHub Dark Default
background = black
background-opacity = 1
font-family = "JetBrains Mono SemiBold"
font-size = 12.5
adjust-cell-width  = -1
adjust-cell-height = 2
mouse-hide-while-typing = true
macos-titlebar-style = hidden
window-padding-x = 15, 15
window-padding-y = 5, 5
shell-integration-features = no-cursor
cursor-style = underline
adjust-cursor-thickness = 2
split-divider-color = #208fff
copy-on-select = clipboard

# ─── Scrollback ───────────────────────────────────────────────────────────────
# Claude Code outputs can be very long; increase the scrollback buffer.
scrollback-limit = 100000

# ─── Window / Split behaviour ─────────────────────────────────────────────────
window-inherit-working-directory = true
focus-follows-mouse = false

# ─── Keybindings – Splits ─────────────────────────────────────────────────────
keybind = super+shift+v=new_split:right
keybind = super+shift+s=new_split:down

# Zoom / un-zoom the focused pane (like tmux prefix-z)
keybind = super+enter=toggle_split_zoom

# Navigate between panes with hjkl  (Cmd+Opt+h/j/k/l)
keybind = super+shift+h=goto_split:left
keybind = super+shift+j=goto_split:down
keybind = super+shift+k=goto_split:up
keybind = super+shift+l=goto_split:right

# Resize focused pane with hjkl  (Cmd+Ctrl+h/j/k/l)
keybind = super+ctrl+h=resize_split:left,20
keybind = super+ctrl+j=resize_split:down,20
keybind = super+ctrl+k=resize_split:up,20
keybind = super+ctrl+l=resize_split:right,20

# Close focused pane / tab
keybind = super+w=close_surface

# ─── Keybindings – Tabs ───────────────────────────────────────────────────────
keybind = super+t=new_tab
keybind = super+shift+left_bracket=previous_tab
keybind = super+shift+right_bracket=next_tab

# Jump to tab by index (Cmd+1…5)
keybind = super+one=goto_tab:1
keybind = super+two=goto_tab:2
keybind = super+three=goto_tab:3
keybind = super+four=goto_tab:4
keybind = super+five=goto_tab:5

keybind = super+shift+u=scroll_page_up
keybind = super+shift+d=scroll_page_down
